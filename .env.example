# Locals Choice Awards — environment template
# Copy to .env.local and replace placeholder values. Never commit real secrets.

# Set to true only for CI/build when secrets are intentionally unavailable.
# On Vercel: do NOT rely on this. Add real Project Environment Variables
# (Production + Preview) so NEXT_PUBLIC_* values are inlined correctly at build.
# Builds also tolerate missing vars during Next.js phase-production-build.
SKIP_ENV_VALIDATION=false

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Supabase (PostgreSQL, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only — never expose to the browser or NEXT_PUBLIC_* vars
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@localschoiceawards.com
NOTIFICATIONS_CRON_SECRET=replace-with-long-random-secret
# Prefer matching Vercel CRON_SECRET so scheduled /api/notifications/process calls authenticate.
CRON_SECRET=replace-with-long-random-secret
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret
UNSUBSCRIBE_TOKEN_SECRET=replace-with-long-random-secret

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sentry (optional in local development)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional local/demo fallback when Supabase community rows are unavailable
USE_PILOT_COMMUNITY_CATALOG=false
